# Use stable IDs and replace these hosts with your receiver addresses.
RECEIVERS='[{"receiver_id":"receiver-1","host":"192.168.88.88"},{"receiver_id":"receiver-2","host":"192.168.88.89"}]'
# Each entry defaults to protocol beast, port 30005.
# Optional single-receiver fallback when RECEIVERS is empty:
# RECEIVER_HOST=192.168.88.88
# RECEIVER_PROTOCOL=avr
# RECEIVER_PORT=47806
HTTP_PORT=8080
AIRCRAFT_TTL_SECONDS=60
RECONNECT_SECONDS=5
RECONNECT_MAX_SECONDS=60
RECEIVER_IDLE_SECONDS=60
# Initial map center when no aircraft positions are available (Germany).
MAP_LAT=51
MAP_LON=10
# Set empty to disable enrichment; a custom path must exist inside the container.
# AIRCRAFT_METADATA_PATH=/app/data/aircraft-metadata.zip
